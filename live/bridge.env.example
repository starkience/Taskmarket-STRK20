# Template for live/.env.local, which is gitignored and holds the real values.
# Copy to live/.env.local and fill in. Never commit a filled-in copy.
#
# Load with:  set -a; . live/.env.local; set +a
#
# The agent is a Node process with no bundler and no browser, so these are read
# from the environment at startup and never shipped anywhere.

# --- StarkWare services (confidential; supplied privately) ---
# bridge-core hardcodes same-origin /rpc, /prover, /indexer with no override.
# src/serviceFetch.ts maps those three prefixes onto these upstreams.
PROVER_URL=
INDEXER_URL=

# Starknet mainnet RPC, full URL including any API key.
STARKNET_RPC_URL=

# --- Agent identity ---
# A fresh, low-value key generated for this demo. NEVER the user's MetaMask key.
# 0x followed by 64 hex characters. Never passed as a CLI argument, never logged.
AGENT_EVM_PRIVATE_KEY=

# Optional second EOA for a live bounty where this agent is the requester.
# Generated by `npm run new-worker-key`; never print or pass it as a CLI argument.
WORKER_EVM_PRIVATE_KEY=

# --- AVNU paymaster ---
# Required: bridge-core's non-paymaster account-deploy path is testnet-only.
AVNU_PAYMASTER_API_KEY=

# --- Pool ---
# Both match bridge-core's baked mainnet defaults; set explicitly for clarity.
PRIVACY_POOL_ADDRESS=0x040337b1af3c663e86e333bab5a4b28da8d4652a15a69beee2b677776ffe812a
CHAIN_ID=0x534e5f4d41494e

# bridge-core defaults to 20. Keep a margin under the pool's ceiling.
PROOF_VALIDITY_BLOCKS=400

# The OZ account class hash declared on mainnet. bridge-core fails loud when
# unset. Not yet supplied — see blocker 3 in the design doc.
OZ_ACCOUNT_CLASS_HASH_MAINNET=
